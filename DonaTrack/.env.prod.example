# Variables del despliegue completo (docker-compose.prod.yml).
# En el servidor: copiar como .env y completar. Nunca commitear el .env con los valores reales.

# Usuario de Docker Hub donde se suben las imágenes (tiene que estar también en tu .env local al hacer build/push)
DOCKERHUB_USER=frantilve

# Dominio público. Sin dominio propio se puede usar sslip.io con la IP del servidor (guiones en vez de puntos):
DOMAIN=68-211-177-89.sslip.io
# URL pública (con https y sin "/" al final). Es la que se configura en el frontend.
PUBLIC_URL=https://68-211-177-89.sslip.io

# Credenciales de infraestructura (evitar @ : / ? # en las contraseñas: van dentro de URIs)
MYSQL_ROOT_PASSWORD=cambiar-por-una-contrasena-segura
RABBITMQ_USER=donatrack
RABBITMQ_PASSWORD=cambiar-por-una-contrasena-segura
MONGO_USER=logistica
MONGO_PASSWORD=cambiar-por-una-contrasena-segura

# Mails (Brevo)
BREVO_API_KEY=
BREVO_REMITENTE=
BREVO_REMITENTE_NOMBRE=DonaTrack
