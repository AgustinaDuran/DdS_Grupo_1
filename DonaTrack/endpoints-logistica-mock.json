              }
            }
          ]
        },
        {
          "name": "Actualizar estado de un envío inexistente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mockUrl}}/v1/shipments/999999/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Failover end-to-end (Donaciones -> broker -> mock)",
      "description": "Prueba el broker de logística. Antes de correr esta carpeta:\n1. Correr las carpetas 01 a 03 de la colección principal (endpoints.json) y copiar acá los valores de donanteId, subcategoriaId y entidadId.\n2. Apagar la logística propia: en el droplet `docker compose -f docker-compose.deploy.yml stop servicio-logistica` (o `docker stop api-logistica` si se prueba en local).\n3. Ajustar esperaPollingMs al intervalo del polling de Donaciones + 5 s (65000 por defecto).\nAl terminar, volver a prender la logística propia con `start`.",
      "item": [
        {
          "name": "Crear donación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donanteId\": {{donanteId}},\n  \"descripcion\": \"Donacion para probar el failover\",\n  \"items\": [\n    {\n      \"nombre\": \"Fideos secos\",\n      \"descripcion\": \"paquete de 500 g\",\n      \"subcategoriaId\": {{subcategoriaId}},\n      \"cantidad\": 100,\n      \"unidad\": \"GRAMO\",\n      \"cantidadBien\": 500,\n      \"fechaVencimiento\": \"2027-01-01\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{donacionesUrl}}/api/donaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar donaciones y guardar donacionId",
          "request": {
            "method": "GET",
            "url": "{{donacionesUrl}}/api/donaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const a=pm.response.json(); const x=a[a.length-1]; pm.test('donacionId',()=>pm.expect(x&&x.id).to.exist); if(x) pm.collectionVariables.set('donacionId',String(x.id));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Asignar donación (el broker la manda al mock)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoEstado\": \"ASIGNACION_REALIZADA\",\n  \"entidadId\": {{entidadId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{donacionesUrl}}/api/donaciones/{{donacionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Buscar en el mock el envío de la donación",
          "request": {
            "method": "GET",
            "url": "{{mockUrl}}/v1/shipments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const ref = pm.collectionVariables.get('donacionId');",
                  "const s = pm.response.json().filter(x => x.externalRef === ref).pop();",
                  "pm.test('el broker registró la entrega en el mock', () => pm.expect(s).to.exist);",
                  "if (s) {",
                  "  pm.collectionVariables.set('shipmentId', String(s.shipmentId));",
                  "  pm.test('arranca en CREATED', () => pm.expect(s.status).to.eql('CREATED'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Simular salida del camión (IN_TRANSIT)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"truckPlate\": \"{{patente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mockUrl}}/v1/shipments/{{shipmentId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Esperar el polling y ver la donación EN_TRASLADO",
          "request": {
            "method": "GET",
            "url": "{{donacionesUrl}}/api/donaciones/{{donacionId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// El polling de Donaciones corre cada logistica.polling.intervalo-ms (60 s por defecto).",
                  "const ms = Number(pm.collectionVariables.get('esperaPollingMs') || 65000);",
                  "setTimeout(() => {}, ms);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('la donación pasó a EN_TRASLADO', () => pm.expect(pm.response.json().estado).to.eql('EN_TRASLADO'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Simular entrega (DELIVERED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mockUrl}}/v1/shipments/{{shipmentId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Esperar el polling y ver la donación ENTREGADA",
          "request": {
            "method": "GET",
            "url": "{{donacionesUrl}}/api/donaciones/{{donacionId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// El polling de Donaciones corre cada logistica.polling.intervalo-ms (60 s por defecto).",
                  "const ms = Number(pm.collectionVariables.get('esperaPollingMs') || 65000);",
                  "setTimeout(() => {}, ms);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('la donación pasó a ENTREGADA', () => pm.expect(pm.response.json().estado).to.eql('ENTREGADA'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
