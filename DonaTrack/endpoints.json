              "raw": "{\n  \"entregas\": [ { \"donacionId\": \"1\", \"direccionDestino\": \"Av Siempreviva 742\" } ]\n}"
            },
            "url": "{{logisticaUrl}}/api/logistica/entregas"
          }
        },
