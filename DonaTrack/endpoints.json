            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patente\": \"AB123CD\",\n  \"capacidadVolumen\": 12.0,\n  \"altura\": 2.5,\n  \"capacidadCarga\": 1600.0\n}"
            },
            "url": "{{logisticaUrl}}/api/logistica/camiones/AB123CD"
          }
        },
        {
          "name": "Actualizar ubicaci\u00f3n del cami\u00f3n",
          "request": {
