                  "raw": "{\n  \"tipoEntidad\": \"COMEDOR\",\n  \"direccion\": \"Av. Siempreviva 742\",\n  \"organizacion\": {\n    \"razonSocial\": \"Comedor Escobar Sonrisas\",\n    \"cuit\": \"30-99999999-9\",\n    \"representantes\": [\n      {\n        \"nombre\": \"Laura\",\n        \"apellido\": \"Gomez\",\n        \"contacto\": {\n          \"medio\": \"MAIL\",\n          \"valor\": \"tumail@frba.utn.edu.ar\"\n        }\n      }\n    ]\n  }\n}",
