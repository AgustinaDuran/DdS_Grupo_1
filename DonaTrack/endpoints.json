                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tipoEstado\": \"ASIGNACION_REALIZADA\",\n  \"entidadId\": {{entidadId}}\n}"
                },
                "url": "{{donacionesUrl}}/api/donaciones/{{donacionId}}",
                "description": "Estados validos: EN_DEPOSITO, ASIGNACION_REALIZADA (requiere entidadId), LISTA_PARA_ENTREGAR, EN_TRASLADO, ENTREGADA, ENTREGA_FALLIDA (agregar JustificacionEntregaFallida), VENCIDA.\n\nASIGNACION_REALIZADA dispara dos integraciones: notifica al donante y a la entidad, y empuja la entrega a Logistica. Si Logistica esta caida devuelve 200 igual y solo loguea un warning."
              }
            },
