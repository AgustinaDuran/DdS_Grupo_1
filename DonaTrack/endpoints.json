            {
              "name": "Crear categoría",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Alimentos\"\n}"
                },
                "url": "{{donacionesUrl}}/api/categorias"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Categoría creada', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                      "pm.sendRequest({ url: pm.collectionVariables.get('donacionesUrl') + '/api/categorias', method: 'GET' }, function (error, response) {",
                      "  if (error) { console.error(error); return; }",
                      "  const lista = response.json();",
                      "  const categoria = lista.filter(x => x.nombre === 'Alimentos').pop() || lista[lista.length - 1];",
                      "  if (categoria && categoria.id != null) pm.collectionVariables.set('categoriaId', String(categoria.id));",
                      "  console.log('categoriaId =', pm.collectionVariables.get('categoriaId'));",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Listar categorías",
              "request": {
                "method": "GET",
                "url": "{{donacionesUrl}}/api/categorias"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('La respuesta es exitosa', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                      "const data = pm.response.json();",
                      "const lista = Array.isArray(data) ? data : (data.content || []);",
                      "const encontrado = lista.filter(x => x.nombre === 'Alimentos').pop() || lista[lista.length - 1];",
                      "pm.test('Se obtuvo categoriaId', function () { pm.expect(encontrado && encontrado.id).to.exist; });",
                      "if (encontrado && encontrado.id != null) pm.collectionVariables.set('categoriaId', String(encontrado.id));",
                      "console.log('categoriaId =', pm.collectionVariables.get('categoriaId'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Obtener categoría por id",
