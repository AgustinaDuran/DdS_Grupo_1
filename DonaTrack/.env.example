# Copiar como .env. No versionar valores reales.
KEYCLOAK_ADMIN_USERNAME=admin-local
KEYCLOAK_ADMIN_PASSWORD=reemplazar-por-una-clave-larga
KEYCLOAK_REGISTRATION_CLIENT_SECRET=reemplazar-por-un-secreto-largo

# Servicio de notificaciones (opcional para autenticación).
BREVO_API_KEY=
BREVO_REMITENTE=
BREVO_REMITENTE_NOMBRE=DonaTrack

# URL del front (redirect URIs de Keycloak y enlace del mail de bienvenida).
FRONTEND_URL=http://localhost:3000

# Social login (opcional). Con *_LOGIN_ENABLED=false el proveedor queda deshabilitado.
# Redirect URI a registrar en el proveedor: http://localhost:8084/realms/donatrack/broker/<google|github>/endpoint
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_LOGIN_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak a usar (opcional). Por defecto, el local de este compose.
# Para usar el Keycloak desplegado junto a Logística (necesario si el front llama a la Logística del servidor),
# descomentar las dos líneas y poner en KEYCLOAK_REGISTRATION_CLIENT_SECRET el mismo secreto que en el servidor.
# KEYCLOAK_PUBLIC_URL=https://auth.68-211-177-89.sslip.io
# KEYCLOAK_INTERNAL_URL=https://auth.68-211-177-89.sslip.io
