# Variables del despliegue de Logística (docker-compose.deploy.yml).
# En el servidor: copiar como .env y completar. Nunca commitear el .env con los valores reales.

# Credenciales de la base documental (MongoDB) de Logística.
# Evitar caracteres reservados de URI (@ : / ? #) en la contraseña: va dentro de la URI de conexión.
MONGO_USER=logistica
MONGO_PASSWORD=cambiar-por-una-contrasena-segura

# URL pública del Servicio de Logística (sin "/" al final)
PUBLIC_URL=http://68.211.177.89:8083

# --- Keycloak (proveedor de identidad) ---
# Dominio público de Keycloak. Sin dominio propio: sslip.io con la IP del servidor (guiones en vez de puntos).
KEYCLOAK_DOMAIN=auth.68-211-177-89.sslip.io
# Usuario de la consola administrativa (https://KEYCLOAK_DOMAIN/admin).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-por-una-contrasena-segura
# Secreto del cliente donatrack-registration. Tiene que ser el MISMO en el .env de Donaciones y en el del front.
KEYCLOAK_REGISTRATION_CLIENT_SECRET=cambiar-por-un-secreto-largo
# URL del front: arma las redirect URIs válidas del login y del logout (sólo se lee en el primer arranque).
FRONTEND_URL=http://localhost:3000
# Memoria máxima (MB) del heap de Keycloak. Bajarla si el servidor tiene poca RAM (mínimo razonable: 256).
KEYCLOAK_HEAP_MB=384
